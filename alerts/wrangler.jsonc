{
  "name": "orbit-watch-alerts",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "triggers": {"crons": ["* * * * *"]},
  "limits": {"cpu_ms": 30000},
  "vars": {"SITE_ORIGIN": "https://orbit-watch-45.hffuh.chatgpt.site"},
  "d1_databases": [{"binding": "DB", "database_name": "orbit-alerts", "database_id": "REPLACE_WITH_DATABASE_ID"}],
  "kv_namespaces": [{"binding": "CATALOG", "id": "REPLACE_WITH_KV_NAMESPACE_ID"}]
}
